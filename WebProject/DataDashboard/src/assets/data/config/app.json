{
  "theme": {
    "primary": "#00d4ff",
    "secondary": "#00ff88",
    "accent": "#ff6b6b",
    "warning": "#ffd93d",
    "info": "#6b5b95",
    "dark": "#0a0e27",
    "light": "#ffffff"
  },
  "chart": {
    "colors": [
      "#00d4ff",
      "#00ff88",
      "#ff6b6b",
      "#ffd93d",
      "#6b5b95",
      "#ff9f43",
      "#54a0ff",
      "#5f27cd",
      "#00d2d3",
      "#ff6b6b"
    ]
  },
  "animation": {
    "duration": {
      "fast": 300,
      "normal": 500,
      "slow": 1000
    },
    "easing": {
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "refresh": {
    "interval": 30000,
    "autoRefresh": true
  }
}
