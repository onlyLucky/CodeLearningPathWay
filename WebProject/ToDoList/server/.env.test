NODE_ENV=test
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=todolist_test
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_POOL_SIZE=5
DB_MAX_QUERY_TIME=1000

JWT_SECRET=test-jwt-secret-key
JWT_EXPIRES_IN=1h

LOG_LEVEL=error
LOG_MAX_SIZE=20m
LOG_MAX_FILES=7d

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=600
REDIS_MAX_RETRIES=2
REDIS_RETRY_DELAY=500
