NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=todolist
DB_SYNCHRONIZE=true
DB_LOGGING=true
DB_POOL_SIZE=10
DB_MAX_QUERY_TIME=1000

JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

LOG_LEVEL=debug
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
