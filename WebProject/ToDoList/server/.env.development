NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=todolist
DB_SYNCHRONIZE=true
DB_LOGGING=true
DB_POOL_SIZE=10
DB_MAX_QUERY_TIME=1000

JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# 密码加密配置
# ENCRYPTION_KEY 必须正好 32 字节（256 位），只使用 ASCII 字符
# ENCRYPTION_IV 必须正好 16 字节（128 位），只使用 ASCII 字符
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456

LOG_LEVEL=debug
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
