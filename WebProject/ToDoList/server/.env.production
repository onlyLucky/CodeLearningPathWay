NODE_ENV=production
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=secure_password_change_in_production
DB_DATABASE=todolist
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=20
DB_MAX_QUERY_TIME=1000

JWT_SECRET=change-this-to-a-very-secure-random-string
JWT_EXPIRES_IN=24h

LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d
