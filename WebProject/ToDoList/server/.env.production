NODE_ENV=production
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=secure_password_change_in_production
DB_DATABASE=todolist
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=20
DB_MAX_QUERY_TIME=1000

JWT_SECRET=change-this-to-a-very-secure-random-string
JWT_EXPIRES_IN=24h

# 密码加密配置
# 生产环境必须使用强随机密钥，请使用以下命令生成：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  # 生成 ENCRYPTION_KEY（64个十六进制字符）
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"  # 生成 ENCRYPTION_IV（32个十六进制字符）
ENCRYPTION_KEY=change-this-to-a-secure-random-32-byte-key-hex-64-chars
ENCRYPTION_IV=change-this-to-a-secure-random-16-byte-iv-hex-32-chars

LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-change-in-production
REDIS_DB=0
REDIS_TTL=7200
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY=2000
